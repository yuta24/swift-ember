// swift-splice: the shape a Release configuration must keep.
//
// Optional. Include it from Release if you want the build to carry an explicit
// record that hot reload is off, rather than relying on nobody having included
// Splice.xcconfig in the wrong place.
//
// There is no Release mode in `doctor`; it only ever asks whether a build is
// ready to be hot reloaded. To check the opposite, look at the shipping binary
// directly -- it must export no dynamic replacement keys:
//
//     nm -gU <Release>.app/<App> | grep -c 'Tx$'      # expect 0
//
// That is the check that cannot be fooled by a setting written in two places.
// examples/CounterApp/build.sh --release does exactly this and fails the build
// on a non-zero count.

SWIFT_ENABLE_TESTABILITY = NO
SPLICE_CONFIGURED = NO
