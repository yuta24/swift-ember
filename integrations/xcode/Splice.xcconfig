// swift-splice: hot reload settings for one Debug configuration.
//
// Include this from the .xcconfig your Debug configuration already uses, or
// set it as the configuration's base configuration file in Xcode:
//
//     #include "path/to/Splice.xcconfig"
//
// Do not include it from a Release configuration. Everything here exists to
// make the running binary patchable, which is the opposite of what a shipping
// build wants. Splice.release.xcconfig next to this file asserts that.

// Replacement dispatch only survives without optimisation. DESIGN.md 12.3.
SWIFT_OPTIMIZATION_LEVEL = -Onone

// Not optional, and the setting most easily missed. Dynamic replacement binds
// through a key symbol, and Swift emits internal declarations with hidden
// visibility; without testability those keys never reach the dynamic symbol
// table and a patch cannot bind to them at all. DESIGN.md 5.4.
SWIFT_ENABLE_TESTABILITY = YES

// -enable-implicit-dynamic is a hidden frontend option, so it needs -Xfrontend;
// the bare spelling is rejected by the driver. It is not a stable interface,
// which is why everything that depends on it lives behind an adapter.
// DESIGN.md 3 and 5.1.
OTHER_SWIFT_FLAGS = $(inherited) -Xfrontend -enable-implicit-dynamic

// Compiles the runtime's dialling and loading code into the app. Without it
// the SpliceRuntime entry point is present but inert.
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) SPLICE_ENABLED

// Read back by `swift-splice doctor` to tell "this project was configured" from
// "these settings happen to be on".
SPLICE_CONFIGURED = YES
