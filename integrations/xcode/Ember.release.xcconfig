// Optional Release-only guard. Keep Ember.xcconfig in the Debug configuration.
// Clearing the Ember variables also neutralizes that file's inherited settings
// while preserving unrelated flags and conditions. Remove literal Ember flags
// from any custom settings, then build and run swift-ember doctor --release.

EMBER_SWIFT_FLAGS =
EMBER_SWIFT_CONDITIONS =
ENABLE_TESTABILITY = NO
SWIFT_ENABLE_TESTABILITY = NO
EMBER_CONFIGURED = NO
